{% comment %} ===========================================================================
   TRMNL private plugin markup — paste into "Edit Markup" (Full view).

   The copy of record lives here, in the repo, because the TRMNL editor is the
   only other place it exists. Data comes from `../trmnl-feed/index.ts`; the
   layout mirrors `components/dev/trmnl-preview.css`, so change both together.

   Left column never branches: now playing, then the program on air.
   Right column switches on `right` — today's schedule, or a live setlist.
   =========================================================================== {% endcomment %}

<style>
  /* The panel is 1-bit. Pure #000 on #fff only — a grey here dithers there. */
  .wted { position: relative; display: flex; height: 100%; color: #000;
          background: #fff; font-family: ui-sans-serif, system-ui, sans-serif; }

  .wted__col { padding: 20px; box-sizing: border-box; overflow: hidden; }
  .wted__col--left { display: flex; flex-direction: column;
                     width: 45%; flex: 0 0 45%; border-right: 2px solid #000; }
  /* padding-bottom keeps the densest setlist clear of the corner mark. */
  .wted__col--right { flex: 1; padding-bottom: 34px; }

  .wted__logo { position: absolute; right: 14px; bottom: 10px;
                width: 58px; height: auto; }

  .wted__eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .12em;
                   text-transform: uppercase; margin-bottom: 8px; }

  .wted__track { font-size: 30px; font-weight: 700; line-height: 1.12; }
  .wted__track-sub { margin-top: 8px; font-size: 14px; line-height: 1.3; }

  /* Cover for the track on air. `min-height: 0` lets it shrink when the title
     runs long, so a three-line track name squeezes the image rather than
     pushing ON AIR off the panel. */
  .wted__art { flex: 0 1 auto; min-height: 0; align-self: flex-start;
               margin-top: 14px; max-width: 150px; max-height: 150px;
               object-fit: contain; border: 1px solid #000; }

  .wted__onair { margin-top: auto; padding-top: 16px; border-top: 1px solid #000; }
  .wted__onair-title { font-size: 18px; font-weight: 600; line-height: 1.2; }
  .wted__onair-time { margin-top: 4px; font-size: 13px; }

  /* Schedule rows. Titles wrap rather than truncate — they routinely end in
     the venue and city, which is the half an ellipsis would eat. */
  .wted__slot { display: flex; align-items: baseline; gap: 10px; padding: 5px 0;
                font-size: 14px; line-height: 1.25; border-bottom: 1px solid #000; }
  .wted__slot-time { flex: 0 0 88px; white-space: nowrap;
                     font-variant-numeric: tabular-nums; }
  .wted__slot-title { flex: 1; min-width: 0; white-space: normal;
                      overflow-wrap: break-word; }
  .wted__slot--now { font-weight: 700; }
  .wted__slot--now .wted__slot-time::after { content: " \25B8"; }

  /* Setlist */
  .wted__venue { font-size: 13px; margin-bottom: 10px; }
  .wted__set { margin-bottom: 8px; }
  .wted__set-label { font-size: 11px; font-weight: 700; letter-spacing: .1em;
                     text-transform: uppercase; border-bottom: 1px solid #000;
                     margin-bottom: 3px; }
  .wted__song { font-size: 14px; line-height: 1.3; }
  .wted__song--now { font-weight: 700; }
  .wted__song--now::before { content: "\25B8 "; }
  .wted__short, .wted__segue { margin-left: 5px; font-size: .85em; }

  /* `density` steps type down instead of dropping content, so a 25-song night —
     or a day of long wrapping titles — still fits. The builder picks the tier
     (`densityForCount`); these are the three steps it selects between. */
  .wted__col--compact .wted__slot { font-size: 12px; line-height: 1.2; padding: 3px 0; }
  .wted__col--compact .wted__slot-time { flex-basis: 76px; }
  .wted__col--compact .wted__song { font-size: 12px; line-height: 1.22; }
  .wted__col--compact .wted__set { margin-bottom: 5px; }

  .wted__col--tight .wted__slot { font-size: 11px; line-height: 1.14; padding: 2px 0; }
  .wted__col--tight .wted__slot-time { flex-basis: 68px; }
  .wted__col--tight .wted__song { font-size: 11px; line-height: 1.12; }
  .wted__col--tight .wted__set { margin-bottom: 3px; }
</style>

<div class="view view--full">
  <div class="wted">

    {% comment %} ------------------------------------------------ left: always the radio {% endcomment %}
    <div class="wted__col wted__col--left">
      <div class="wted__eyebrow">Now Playing on WTED Radio</div>

      {% if now_playing %}
        <div class="wted__track">{{ now_playing.primary }}</div>
        {% if now_playing.secondary %}
          <div class="wted__track-sub">{{ now_playing.secondary }}</div>
        {% endif %}
      {% else %}
        <div class="wted__track">WTED Goose Radio</div>
      {% endif %}

      {% if now_playing.artwork %}
        <img class="wted__art image" src="{{ now_playing.artwork }}" alt="" />
      {% endif %}

      {% if on_air %}
        <div class="wted__onair">
          <div class="wted__eyebrow">On Air</div>
          <div class="wted__onair-title">{{ on_air.title }}</div>
          <div class="wted__onair-time">{{ on_air.time }}</div>
        </div>
      {% endif %}
    </div>

    {% comment %} ------------------------------------ right: schedule, or a live setlist {% endcomment %}
    <div class="wted__col wted__col--right wted__col--{{ density }}">

      {% if right == "setlist" %}
        <div class="wted__eyebrow">Live Now &middot; {{ live.date }}</div>
        <div class="wted__venue">{{ live.venue }}{% if live.location %} &mdash; {{ live.location }}{% endif %}</div>

        {% for set in live.sets %}
          <div class="wted__set">
            <div class="wted__set-label">{{ set.label }}</div>
            {% for entry in set.entries %}
              <div class="wted__song{% if entry.now %} wted__song--now{% endif %}">
                {{ entry.song }}
                {% if entry.short %}<span class="wted__short">[{{ entry.short }}]</span>{% endif %}
                {% comment %}
                  Three states, and Liquid handles them for free: only nil and
                  false are falsy here, so an empty string is truthy. null → no
                  arrow; "" → a bare arrow; text → a labelled one.
                {% endcomment %}
                {% if entry.segue %}
                  <span class="wted__segue">&rarr;{% if entry.segue != "" %} {{ entry.segue }}{% endif %}</span>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endfor %}

      {% else %}
        <div class="wted__eyebrow">Today on WTED Radio</div>
        {% for row in schedule %}
          <div class="wted__slot{% if row.now %} wted__slot--now{% endif %}">
            <span class="wted__slot-time">{{ row.time }}</span>
            <span class="wted__slot-title">{{ row.title }}</span>
          </div>
        {% else %}
          <div class="wted__slot"><span class="wted__slot-title">No schedule today</span></div>
        {% endfor %}
      {% endif %}

    </div>

    {% comment %} Station mark, bottom-right of the panel, over both columns. {% endcomment %}
    <img class="wted__logo image" src="https://wtedradio.com/WL.png" alt="" />
  </div>
</div>
